      "notes": "Balances, net worth, bank-vs-Actual reconciliation, recent runs. Counts only.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst eur = c => (c / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });\nconst date = new Date().toISOString().slice(0, 10);\nconst imported = $('Import into Actual').isExecuted ? $('Import into Actual').first().json : null;\n\nconst lines = [`# Budget summary ${date}`, ''];\nlines.push('## Accounts');\nfor (const a of s.accounts) {\n  lines.push(`- ${a.name}${a.off_budget ? ' (off-budget)' : ''}: ${eur(a.balance_cents)}`);\n}\nlines.push('', `**Net worth:** ${eur(s.net_worth_cents)}`, '');\n\nlines.push('## This run');\nif (imported) {\n  const pending = imported.pending ? `, ${imported.pending} pending skipped` : '';\n  lines.push(`- Postbank Giro: ${imported.fetched} rows from ${imported.files.length} file(s) → ${imported.added} added, ${imported.updated} updated, ${imported.unchanged} already known${pending}`);\n} else {\n  lines.push('- Postbank Giro: nothing to import (inbox empty)');\n}\nfor (const r of (s.reconciliation || [])) {\n  lines.push(r.reconciled\n    ? `- ${r.account}: matches the bank's last stated balance ✓`\n    : `- ${r.account}: differs from the bank's last stated balance by ${eur(r.delta_cents)} (run \\`pipeline opening-balance\\` once, or check for a gap between exports)`);\n}\nconst waiting = Object.entries(s.inbox_pending_files || {}).filter(([, n]) => n > 0);\nif (waiting.length) {\n  lines.push(`- Files still waiting in inbox: ${waiting.map(([k, n]) => `${k} (${n})`).join(', ')}`);\n}\n\n\nif ((s.proposals_pending || []).length) {\n  lines.push('', '## Proposed rules awaiting your review');\n  lines.push('| id | payee | proposed category | confidence | rows |', '|---|---|---|---|---|');\n  for (const p of s.proposals_pending) lines.push(`| ${p.short_id} | ${p.payee} | ${p.category} | ${Math.round(p.confidence * 100)}% | ${p.tx_count ?? ''} |`);\n  lines.push('', 'Approve: `pipeline approve <id>` · reject: `pipeline reject <id>` · all confident ones: `pipeline approve --min-confidence 0.9`');\n}\nlines.push('', '## Recent runs');\nfor (const r of (s.recent_runs || []).slice(0, 5)) {\n  lines.push(`- ${String(r.started_at).slice(0, 16)} ${r.source_id}: ${r.status} (+${r.new_rows ?? 0} new, ${r.unchanged_rows ?? 0} known)`);\n}\n\nreturn [{ json: { text: lines.join('\\n'), filename: `budget-summary-${date}.md`, net_worth_cents: s.net_worth_cents } }];"
      },
