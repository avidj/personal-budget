      "id": "summary-fetch",
      "name": "Summary from pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2584,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
